{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/apply_v02_migration.output.schema.json",
  "$comment": "base_revision/result_revision equality and canonical changed_paths are enforced by the MCP apply output invariant because JSON Schema cannot compare sibling values or reuse the Go revision-path grammar. The authorization proof and durable commit receipt remain input/internal evidence and are intentionally absent from this closed output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "source",
    "base_revision",
    "result_revision",
    "plan_digest",
    "changed_paths",
    "diagnostics"
  ],
  "properties": {
    "status": {"enum": ["applied", "noop", "rejected"]},
    "source": {"$ref": "#/$defs/source_resolution"},
    "base_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {
      "type": "string",
      "pattern": "^(?:|sha256:[0-9a-f]{64})$"
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/output_path"}
    },
    "diagnostics": {"$ref": "#/$defs/wire_diagnostics"}
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "applied"},
        "source": {"$ref": "#/$defs/applicable_v01_source_resolution"},
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {"type": "array", "minItems": 1},
        "diagnostics": {"const": []}
      }
    },
    {
      "properties": {
        "status": {"const": "noop"},
        "source": {"$ref": "#/$defs/applicable_v01_source_resolution"},
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {"const": []},
        "diagnostics": {"$ref": "#/$defs/non_error_wire_diagnostics"}
      }
    },
    {
      "properties": {
        "status": {"const": "noop"},
        "source": {"$ref": "#/$defs/applicable_target_source_resolution"},
        "plan_digest": {"const": ""},
        "changed_paths": {"const": []},
        "diagnostics": {"const": []}
      }
    },
    {
      "properties": {
        "status": {"const": "rejected"},
        "source": {"$ref": "#/$defs/applicable_v01_source_resolution"},
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {"const": []},
        "diagnostics": {"$ref": "#/$defs/error_wire_diagnostics"}
      }
    }
  ]
}
