{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/preview_temporal_upgrade.input.schema.json",
  "type": "object",
  "required": [
    "bundle_path",
    "id",
    "actor"
  ],
  "properties": {
    "bundle_path": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mappings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mapping": {
      "type": "object",
      "required": [
        "concept",
        "path",
        "from",
        "to"
      ],
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "not": {
            "pattern": "-00:00$"
          },
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"
        }
      },
      "additionalProperties": false
    }
  }
}
