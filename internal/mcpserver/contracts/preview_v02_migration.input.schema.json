{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/preview_v02_migration.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_path",
    "timestamp_policy",
    "citation_mappings"
  ],
  "properties": {
    "bundle_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "from": {
      "enum": [
        "auto",
        "0.1",
        "0.2"
      ],
      "default": "auto"
    },
    "generated_by": {
      "type": "string",
      "maxLength": 256
    },
    "generated_at": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "at"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "timestamp_conflict_policy": {
      "enum": [
        "reject",
        "use_generated",
        "use_timestamp"
      ],
      "default": "reject"
    },
    "timestamp_policy": {
      "enum": [
        "preserve",
        "remove_after_copy"
      ]
    },
    "citation_mappings": {
      "$ref": "#/$defs/citation_mappings"
    },
    "computations": {
      "$ref": "#/$defs/computations"
    }
  },
  "$defs": {
    "computation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime",
        "parameters",
        "executor",
        "attester"
      ],
      "properties": {
        "mode": {
          "enum": [
            "inline",
            "file"
          ]
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parameters": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "computation_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inline_computation": {
          "type": "string",
          "maxLength": 1048576
        },
        "inline_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource",
            "receipt"
          ],
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "receipt": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "attester": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource"
          ],
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "file"
            }
          },
          "required": [
            "computation_path"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "inline_computation"
                ]
              },
              {
                "required": [
                  "inline_language"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "inline"
            }
          },
          "required": [
            "inline_computation"
          ],
          "not": {
            "required": [
              "computation_path"
            ]
          }
        }
      ]
    },
    "citation_mappings": {
      "description": "Mappings must carry durable replay evidence. Reserved root/nested index.md and root log.md documents require exact legacy_entry bytes or an explicit resource projection; number-only selection is sufficient only for concepts whose structured sources persist the projection.",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "entries"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id"
              ],
              "properties": {
                "legacy_number": {
                  "description": "Legacy numeric selector; not durable replay evidence for reserved index/log documents.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "legacy_entry": {
                  "description": "Exact raw legacy citation entry bytes used to bind transition and target-noop replay.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "title": {
                  "description": "Optional link title; requires resource to form a complete explicit projection.",
                  "type": "string",
                  "maxLength": 4096
                },
                "resource": {
                  "description": "Explicit replayable resource; alone produces a bare resource definition and with title produces a titled link.",
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "anyOf": [
                {
                  "required": [
                    "legacy_number"
                  ]
                },
                {
                  "required": [
                    "legacy_entry"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "computations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "contract"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contract": {
            "$ref": "#/$defs/computation_contract"
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "content": {
                "type": "string",
                "maxLength": 8388608
              }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "contract": {
                "properties": {
                  "mode": {
                    "const": "file"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "asset"
            ]
          },
          {
            "properties": {
              "contract": {
                "properties": {
                  "mode": {
                    "const": "inline"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "not": {
              "required": [
                "asset"
              ]
            }
          }
        ]
      }
    }
  }
}
