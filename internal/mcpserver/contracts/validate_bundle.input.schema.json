{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/validate_bundle.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_path"],
  "properties": {
    "bundle_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "strict": {"type": "boolean", "default": false},
    "check_links": {"type": "boolean", "default": false},
    "check_orphans": {"type": "boolean", "default": false},
    "target_version": {"enum": ["auto", "0.1", "0.2"], "default": "auto"},
    "temporal_profile": {"enum": ["date-3fcbb9f", "instant-0b87c52"], "default": "date-3fcbb9f"},
    "as_of": {"type": "string"}
  },
  "allOf": [{"if": {"properties": {"temporal_profile": {"const": "instant-0b87c52"}}, "required": ["temporal_profile"]}, "then": {"properties": {"as_of": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$", "not": {"pattern": "-00:00$"}}}}, "else": {"properties": {"as_of": {"format": "date"}}}}]
}
