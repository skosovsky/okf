{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/search_concepts.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "as_of",
    "total",
    "truncated",
    "hits",
    "temporal_profile"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "as_of": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "hits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "match"
        ],
        "properties": {
          "concept": {
            "$ref": "#/$defs/card"
          },
          "match": {
            "enum": [
              "id",
              "title",
              "description",
              "tags",
              "body"
            ]
          }
        }
      }
    },
    "temporal_profile": {
      "enum": [
        "date-3fcbb9f",
        "instant-0b87c52"
      ]
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "type",
        "title",
        "description",
        "tags",
        "status",
        "trust",
        "stale",
        "stale_after",
        "status_state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust": {
          "enum": [
            "unverified",
            "machine-confirmed",
            "human-reviewed"
          ]
        },
        "stale": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stale_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "valid",
            "raw",
            "effective"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "valid": {
              "type": "boolean"
            },
            "raw": {
              "type": [
                "string",
                "null"
              ]
            },
            "effective": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
