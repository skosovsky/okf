{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/apply_v02_migration.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_path", "timestamp_policy", "citation_mappings", "expected_source"],
  "properties": {
    "bundle_path": {"examples": ["/workspace/knowledge"], "description": "Local OKF bundle root path (up to 4096 characters where constrained); server enforces root and symlink boundaries. Example: /workspace/knowledge.", "type": "string", "minLength": 1, "maxLength": 4096},
    "from": {"examples": ["auto"], "description": "Source version: auto (default), 0.1 or 0.2; auto resolves from the bundle.", "enum": ["auto", "0.1", "0.2"], "default": "auto"},
    "generated_by": {"examples": ["human:reviewer"], "description": "Producer provenance for migrated generated fields, e.g. human:reviewer; not an authorization principal.", "type": "string", "maxLength": 256},
    "generated_at": {"examples": [[{"concept_id": "architecture/cache", "at": "2026-09-27T10:00:00Z"}]], "description": "Explicit per-concept generated timestamps (RFC 3339 date-time); no inferred time is supplied.",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_id", "at"],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1, "maxLength": 4096},
          "at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "timestamp_conflict_policy": {"examples": ["reject"], "description": "How to resolve an existing timestamp versus generated.at; reject by default.",
      "enum": ["reject", "use_generated", "use_timestamp"],
      "default": "reject"
    },
    "timestamp_policy": {"examples": ["preserve"], "description": "Preserve legacy timestamp or remove it after copying to generated.at; required.", "enum": ["preserve", "remove_after_copy"]},
    "citation_mappings": {"description": "Explicit citation mappings with replay-sufficient selectors; use exact legacy_entry bytes or resource projection for reserved index/log documents.", "$ref": "#/$defs/citation_mappings"},
    "computations": {"description": "Explicit attested computation mappings; computation content is inert and is never executed by this tool.", "$ref": "#/$defs/computations"},
    "proof": {"description": "Preview proof for a v0.1→v0.2 transition; copy from matching preview unchanged.", "$ref": "#/$defs/plan_proof"},
    "expected_plan_digest": {"examples": ["sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"], "description": "Plan digest (sha256: plus 64 lowercase hex digits) returned by the matching preview; required for a migration transition.",
      "type": "string",
      "pattern": "^(?:|sha256:[0-9a-f]{64})$"
    },
    "expected_source": {"description": "Source resolution tuple returned by preview_v02_migration; apply rechecks it against the current bundle.", "$ref": "#/$defs/applicable_source_resolution"}
  },
  "allOf": [
    {
      "if": {"not": {"required": ["from"]}},
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "auto"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"from": {"const": "auto"}},
        "required": ["from"]
      },
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "auto"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"from": {"const": "0.1"}},
        "required": ["from"]
      },
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "0.1"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"from": {"const": "0.2"}},
        "required": ["from"]
      },
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "0.2"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_source": {
            "properties": {"transition": {"const": "v0.1-to-v0.2"}},
            "required": ["transition"]
          }
        },
        "required": ["expected_source"]
      },
      "then": {
        "required": ["proof", "expected_plan_digest"],
        "properties": {
          "expected_plan_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_source": {
            "properties": {"transition": {"const": "target-noop"}},
            "required": ["transition"]
          }
        },
        "required": ["expected_source"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["proof"]},
            {"required": ["expected_plan_digest"]}
          ]
        }
      }
    }
  ]
}
