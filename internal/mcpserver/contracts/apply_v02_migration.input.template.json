{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/apply_v02_migration.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_path", "timestamp_policy", "citation_mappings", "expected_source"],
  "properties": {
    "bundle_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "from": {"enum": ["auto", "0.1", "0.2"], "default": "auto"},
    "generated_by": {"type": "string", "maxLength": 256},
    "generated_at": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_id", "at"],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1, "maxLength": 4096},
          "at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "timestamp_conflict_policy": {
      "enum": ["reject", "use_generated", "use_timestamp"],
      "default": "reject"
    },
    "timestamp_policy": {"enum": ["preserve", "remove_after_copy"]},
    "citation_mappings": {"$ref": "#/$defs/citation_mappings"},
    "computations": {"$ref": "#/$defs/computations"},
    "proof": {"$ref": "#/$defs/plan_proof"},
    "expected_plan_digest": {
      "type": "string",
      "pattern": "^(?:|sha256:[0-9a-f]{64})$"
    },
    "expected_source": {"$ref": "#/$defs/applicable_source_resolution"}
  },
  "allOf": [
    {
      "if": {"not": {"required": ["from"]}},
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "auto"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"from": {"const": "auto"}},
        "required": ["from"]
      },
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "auto"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"from": {"const": "0.1"}},
        "required": ["from"]
      },
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "0.1"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"from": {"const": "0.2"}},
        "required": ["from"]
      },
      "then": {
        "properties": {
          "expected_source": {
            "properties": {"requested_selector": {"const": "0.2"}},
            "required": ["requested_selector"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_source": {
            "properties": {"transition": {"const": "v0.1-to-v0.2"}},
            "required": ["transition"]
          }
        },
        "required": ["expected_source"]
      },
      "then": {
        "required": ["proof", "expected_plan_digest"],
        "properties": {
          "expected_plan_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_source": {
            "properties": {"transition": {"const": "target-noop"}},
            "required": ["transition"]
          }
        },
        "required": ["expected_source"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["proof"]},
            {"required": ["expected_plan_digest"]}
          ]
        }
      }
    }
  ]
}
