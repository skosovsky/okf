{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/apply_concept_patch.output.schema.json",
  "$comment": "base_revision/result_revision equality and canonical changed_paths are enforced by the MCP apply output invariant because JSON Schema cannot compare sibling values or reuse the Go revision-path grammar. Commit receipts and migration proofs are intentionally not public output fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "base_revision", "result_revision", "plan_digest", "changed_paths", "diagnostics"],
  "properties": {
    "status": {"enum": ["applied", "noop", "rejected"]},
    "base_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "changed_paths": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "file", "field", "message", "spec_ref", "policy_failure"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["ERROR", "WARN", "INFO"]},
          "file": {"type": "string"},
          "field": {"type": "string"},
          "message": {"type": "string"},
          "spec_ref": {"type": "string"},
          "policy_failure": {"type": "boolean"}
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "applied"},
        "changed_paths": {"type": "array", "minItems": 1},
        "diagnostics": {"const": []}
      }
    },
    {
      "properties": {
        "status": {"const": "noop"},
        "changed_paths": {"const": []},
        "diagnostics": {"const": []}
      }
    },
    {
      "properties": {
        "status": {"const": "rejected"},
        "changed_paths": {"const": []},
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "additionalProperties": true,
            "required": ["severity"],
            "properties": {
              "severity": {"const": "ERROR"}
            }
          }
        }
      }
    }
  ]
}
