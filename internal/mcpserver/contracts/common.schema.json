{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/common.schema.json",
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "concept_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\\\x00-\\x1F\\x7F]+(?:/[^/\\\\\\x00-\\x1F\\x7F]+)*$",
      "allOf": [
        {"not": {"pattern": "(^|/)\\."}},
        {"not": {"pattern": "(^|/)(index|log)(/|$)"}},
        {"not": {"pattern": "\\.md$"}},
        {"not": {"pattern": ":"}},
        {"not": {"pattern": "^\\s"}},
        {"not": {"pattern": "\\s$"}}
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "file", "field", "message", "spec_ref", "policy_failure"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["ERROR", "WARN", "INFO"]},
        "file": {"type": "string"},
        "field": {"type": "string"},
        "message": {"type": "string"},
        "spec_ref": {"type": "string"},
        "policy_failure": {"type": "boolean"}
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "effective", "resolution", "compatibility"],
      "properties": {
        "declared": {"type": ["string", "null"]},
        "effective": {"type": ["string", "null"]},
        "resolution": {"enum": ["declared", "default", "explicit", "future-best-effort", null]},
        "compatibility": {"enum": ["native", "legacy", "best-effort", null]}
      }
    }
  }
}
