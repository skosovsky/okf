{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/apply_v02_migration.output.schema.json",
  "$comment": "base_revision/result_revision equality and canonical changed_paths are enforced by the MCP apply output invariant because JSON Schema cannot compare sibling values or reuse the Go revision-path grammar. The authorization proof and durable commit receipt remain input/internal evidence and are intentionally absent from this closed output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "source",
    "base_revision",
    "result_revision",
    "plan_digest",
    "changed_paths",
    "diagnostics"
  ],
  "properties": {
    "status": {
      "enum": [
        "applied",
        "noop",
        "rejected"
      ]
    },
    "source": {
      "$ref": "#/$defs/source_resolution"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^(?:|sha256:[0-9a-f]{64})$"
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/output_path"
      }
    },
    "diagnostics": {
      "$ref": "#/$defs/wire_diagnostics"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "applied"
        },
        "source": {
          "$ref": "#/$defs/applicable_v01_source_resolution"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1
        },
        "diagnostics": {
          "const": []
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "noop"
        },
        "source": {
          "$ref": "#/$defs/applicable_v01_source_resolution"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {
          "const": []
        },
        "diagnostics": {
          "$ref": "#/$defs/non_error_wire_diagnostics"
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "noop"
        },
        "source": {
          "$ref": "#/$defs/applicable_target_source_resolution"
        },
        "plan_digest": {
          "const": ""
        },
        "changed_paths": {
          "const": []
        },
        "diagnostics": {
          "const": []
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "rejected"
        },
        "source": {
          "$ref": "#/$defs/applicable_v01_source_resolution"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {
          "const": []
        },
        "diagnostics": {
          "$ref": "#/$defs/error_wire_diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "wire_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "file",
        "field",
        "message",
        "spec_ref",
        "policy_failure"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARN",
            "INFO"
          ]
        },
        "file": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "spec_ref": {
          "type": "string"
        },
        "policy_failure": {
          "type": "boolean"
        }
      }
    },
    "wire_diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/wire_diagnostic"
      }
    },
    "non_error_wire_diagnostics": {
      "allOf": [
        {
          "$ref": "#/$defs/wire_diagnostics"
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "severity"
              ],
              "properties": {
                "severity": {
                  "const": "ERROR"
                }
              }
            }
          }
        }
      ]
    },
    "error_wire_diagnostics": {
      "allOf": [
        {
          "$ref": "#/$defs/wire_diagnostics"
        },
        {
          "minItems": 1,
          "contains": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "severity"
            ],
            "properties": {
              "severity": {
                "const": "ERROR"
              }
            }
          }
        }
      ]
    },
    "source_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_selector",
        "declaration_present",
        "declaration_valid",
        "declaration_raw",
        "declared_version",
        "resolved_source",
        "resolution_source",
        "from_version",
        "to_version",
        "transition",
        "candidates",
        "blockers"
      ],
      "properties": {
        "requested_selector": {
          "enum": [
            "auto",
            "0.1",
            "0.2"
          ]
        },
        "declaration_present": {
          "type": "boolean"
        },
        "declaration_valid": {
          "type": "boolean"
        },
        "declaration_raw": {
          "type": "string"
        },
        "declared_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_source": {
          "type": "string"
        },
        "resolution_source": {
          "enum": [
            "explicit",
            "declared",
            "legacy-probe",
            "default",
            "future"
          ]
        },
        "from_version": {
          "type": "string"
        },
        "to_version": {
          "type": "string"
        },
        "transition": {
          "enum": [
            "v0.1-to-v0.2",
            "target-noop",
            "blocked"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "location"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "timestamp",
                  "citations"
                ]
              },
              "path": {
                "type": "string"
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "path",
              "location",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "applicable_v01_source_resolution": {
      "allOf": [
        {
          "$ref": "#/$defs/source_resolution"
        },
        {
          "properties": {
            "declaration_valid": {
              "const": true
            },
            "resolved_source": {
              "const": "0.1"
            },
            "from_version": {
              "const": "0.1"
            },
            "to_version": {
              "const": "0.2"
            },
            "transition": {
              "const": "v0.1-to-v0.2"
            },
            "blockers": {
              "const": []
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "requested_selector": {
                  "const": "0.1"
                },
                "declaration_present": {
                  "const": false
                },
                "declaration_raw": {
                  "const": ""
                },
                "declared_version": {
                  "type": "null"
                },
                "resolution_source": {
                  "const": "explicit"
                },
                "candidates": {
                  "const": []
                }
              }
            },
            {
              "properties": {
                "requested_selector": {
                  "const": "0.1"
                },
                "declaration_present": {
                  "const": true
                },
                "declaration_raw": {
                  "const": "0.1"
                },
                "declared_version": {
                  "const": "0.1"
                },
                "resolution_source": {
                  "const": "explicit"
                },
                "candidates": {
                  "const": []
                }
              }
            },
            {
              "properties": {
                "requested_selector": {
                  "const": "auto"
                },
                "declaration_present": {
                  "const": true
                },
                "declaration_raw": {
                  "const": "0.1"
                },
                "declared_version": {
                  "const": "0.1"
                },
                "resolution_source": {
                  "const": "declared"
                },
                "candidates": {
                  "const": []
                }
              }
            },
            {
              "properties": {
                "requested_selector": {
                  "const": "auto"
                },
                "declaration_present": {
                  "const": false
                },
                "declaration_raw": {
                  "const": ""
                },
                "declared_version": {
                  "type": "null"
                },
                "resolution_source": {
                  "const": "legacy-probe"
                },
                "candidates": {
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          ]
        }
      ]
    },
    "applicable_target_source_resolution": {
      "allOf": [
        {
          "$ref": "#/$defs/source_resolution"
        },
        {
          "properties": {
            "declaration_valid": {
              "const": true
            },
            "resolved_source": {
              "const": "0.2"
            },
            "from_version": {
              "const": "0.2"
            },
            "to_version": {
              "const": "0.2"
            },
            "transition": {
              "const": "target-noop"
            },
            "blockers": {
              "const": []
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "requested_selector": {
                  "const": "0.2"
                },
                "declaration_present": {
                  "const": false
                },
                "declaration_raw": {
                  "const": ""
                },
                "declared_version": {
                  "type": "null"
                },
                "resolution_source": {
                  "const": "explicit"
                },
                "candidates": {
                  "const": []
                }
              }
            },
            {
              "properties": {
                "requested_selector": {
                  "const": "0.2"
                },
                "declaration_present": {
                  "const": true
                },
                "declaration_raw": {
                  "const": "0.2"
                },
                "declared_version": {
                  "const": "0.2"
                },
                "resolution_source": {
                  "const": "explicit"
                },
                "candidates": {
                  "const": []
                }
              }
            },
            {
              "properties": {
                "requested_selector": {
                  "const": "auto"
                },
                "declaration_present": {
                  "const": true
                },
                "declaration_raw": {
                  "const": "0.2"
                },
                "declared_version": {
                  "const": "0.2"
                },
                "resolution_source": {
                  "const": "declared"
                },
                "candidates": {
                  "const": []
                }
              }
            },
            {
              "properties": {
                "requested_selector": {
                  "const": "auto"
                },
                "declaration_present": {
                  "const": false
                },
                "declaration_raw": {
                  "const": ""
                },
                "declared_version": {
                  "type": "null"
                },
                "resolution_source": {
                  "const": "default"
                },
                "candidates": {
                  "const": []
                }
              }
            }
          ]
        }
      ]
    }
  }
}
