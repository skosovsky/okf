{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okf.dev/mcp/v0.2/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable", "diagnostics"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "file", "field", "message", "spec_ref", "policy_failure"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["ERROR", "WARN", "INFO"]},
          "file": {"type": "string"},
          "field": {"type": "string"},
          "message": {"type": "string"},
          "spec_ref": {"type": "string"},
          "policy_failure": {"type": "boolean"}
        }
      }
    }
  }
}
