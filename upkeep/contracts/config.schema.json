{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OKF upkeep configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo_root", "bundle_root", "relevant_paths"],
  "properties": {
    "repo_root": {"type": "string", "minLength": 1},
    "bundle_root": {"$ref": "#/$defs/relativePath"},
    "relevant_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}},
    "exclude_paths": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}},
    "mode": {"enum": ["advisory", "blocking"], "default": "advisory"},
    "failure_policy": {"enum": ["open", "closed"], "default": "open"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000, "default": 5000},
    "max_session_minutes": {"type": "integer", "minimum": 1, "maximum": 10080, "default": 1440}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "description": "A clean repository-relative path; Go validation rejects dot segments, traversal, and absolute paths."}
  }
}
