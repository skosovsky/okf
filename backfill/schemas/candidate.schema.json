{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skosovsky/okf/backfill/schemas/candidate.schema.json",
  "title": "OKF backfill candidate desired state v1",
  "type": "object",
  "required": ["id", "concept_id", "title", "description", "body", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "concept_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
    "body": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["event_id", "path", "diff_sha256"], "properties": {"event_id": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "history": {"type": "array", "items": {"type": "object", "required": ["event_id", "text"], "properties": {"event_id": {"type": "string"}, "text": {"type": "string"}}, "additionalProperties": false}},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "unresolved_conflict": {"type": "string"}, "evidence_incomplete": {"type": "boolean"}
  }, "additionalProperties": false
}
