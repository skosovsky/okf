{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skosovsky/okf/backfill/schemas/checkpoint.schema.json",
  "title": "OKF backfill resume checkpoint v1",
  "type": "object",
  "required": ["schema_version", "extractor_version", "config_sha256", "events_sha256", "analysis_sha256", "plan_sha256", "prompt_version", "next_candidate", "base_revision", "receipts"],
  "properties": {
    "schema_version": {"const": "okf-backfill/v1"}, "extractor_version": {"const": "git-extractor/v1"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "events_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_version": {"type": "string"},
    "next_candidate": {"type": "integer", "minimum": 0},
    "base_revision": {"type": "string"},
    "receipts": {"type": "array", "items": {"type": "object"}}
  }, "additionalProperties": false
}
