{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skosovsky/okf/benchmark/agent/schema.json",
  "title": "OKF agent benchmark wire format",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "evidence",
        "support"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stale_answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "repo_path": {
                "type": "string",
                "minLength": 1
              },
              "control_quote": {
                "type": "string",
                "minLength": 1
              },
              "treatment_quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "quote"
                ]
              },
              {
                "required": [
                  "control_quote",
                  "treatment_quote"
                ]
              }
            ]
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "tier",
        "question",
        "control",
        "treatment",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "realistic",
            "mechanism_only"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "control": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "treatment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cache_tokens",
        "elapsed_ms",
        "toolkit_calls"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refused": {
          "type": "boolean"
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "adapter_error": {
          "type": "string"
        },
        "toolkit_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_trace": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event"],
            "properties": {
              "event": {"type": "string"},
              "item_type": {"type": "string"},
              "status": {"type": "string"},
              "command_kind": {"type": "string"},
              "command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "exit_code": {"type": "integer"}
            }
          }
        },
        "event_trace_truncated": {"type": "boolean"},
        "read_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "corpus_sha256",
        "prompt_sha256",
        "commit",
        "spec_revision",
        "model",
        "model_version",
        "settings",
        "adapter",
        "clock",
        "grader_revision"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "spec_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "model": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "settings": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "clock": {
          "type": "string",
          "format": "date-time"
        },
        "grader_revision": {
          "const": "exact-v1"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "case_id",
        "arm",
        "repeat",
        "observation",
        "retries",
        "verdict",
        "trial_elapsed_ms"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "case_id": {
          "type": "string"
        },
        "arm": {
          "enum": [
            "control",
            "treatment"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "failure": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "enum": [
            "correct",
            "stale",
            "wrong",
            "refusal",
            "ungradable",
            "operational_failure"
          ]
        },
        "trial_elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "toolkit_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "runner_toolkit_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "arm",
        "question",
        "artifacts",
        "instructions"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "arm": {
          "enum": [
            "control",
            "treatment"
          ]
        },
        "question": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "arm_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "observed",
        "missing",
        "correct",
        "stale",
        "wrong",
        "refusal",
        "ungradable",
        "operational_failure",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cache_tokens",
        "elapsed_ms",
        "factual_attempts",
        "factual_error_rate",
        "stale_rate",
        "completion_rate",
        "cost_known_trials",
        "cost_usd"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "wrong": {
          "type": "integer",
          "minimum": 0
        },
        "refusal": {
          "type": "integer",
          "minimum": 0
        },
        "ungradable": {
          "type": "integer",
          "minimum": 0
        },
        "operational_failure": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "model_toolkit_calls": {
          "type": "integer",
          "minimum": 0
        },
        "runner_toolkit_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "factual_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "factual_error_rate": {
          "type": "number",
          "minimum": 0
        },
        "stale_rate": {
          "type": "number",
          "minimum": 0
        },
        "completion_rate": {
          "type": "number",
          "minimum": 0
        },
        "cost_known_trials": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_sha256",
        "run_id",
        "repeat_count",
        "valid",
        "arms",
        "invalid_raw_rows"
      ],
      "properties": {
        "corpus_sha256": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "model_runtime_path": {
          "type": "string"
        },
        "model_runtime_version": {
          "type": "string"
        },
        "model_runtime_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_hash_scope": {"type": "string", "enum": ["shared_request_instructions_only"]},
        "tool_call_accounting": {"type": "string", "enum": ["separate-v1"]},
        "repeat_count": {
          "type": "integer",
          "minimum": 1
        },
        "valid": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arms": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/arm_report"
          }
        },
        "invalid_raw_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "repeats",
        "case_count",
        "max_trials",
        "max_seconds",
        "max_tokens",
        "max_cost_usd",
        "unpriced",
        "spec_sha256",
        "adapter_sha256",
        "toolkit_mode",
        "model_tool_access",
        "exploratory"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_trials": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "unpriced": {
          "type": "boolean"
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_hash_scope": {"type": "string", "enum": ["shared_request_instructions_only"]},
        "tool_call_accounting": {"type": "string", "enum": ["separate-v1"]},
        "toolkit_mode": {
          "enum": [
            "none",
            "treatment",
            "both",
            "direct"
          ]
        },
        "model_tool_access": {
          "type": "string",
          "minLength": 1
        },
        "exploratory": {
          "type": "boolean"
        },
        "go_cli_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_runtime_path": {
          "type": "string"
        },
        "model_runtime_version": {
          "type": "string"
        },
        "model_runtime_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diagnostic_read": {
          "type": "boolean"
        }
      }
    }
  },
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/case"
  }
}
